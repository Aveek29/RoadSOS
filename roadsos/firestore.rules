rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Incidents Collection
    // - Any authenticated user can read or register an incident.
    // - Updates are restricted to the victim themselves or an admin.
    match /incidents/{incidentId} {
      allow create, read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.role == 'ADMIN'
      );

      // Embedded dispatch volunteers
      match /volunteers/{volunteerId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == volunteerId ||
          resource.data.assignedAdmin == request.auth.uid
        );
      }
    }

    // Helpers Registry (Geohash presence index)
    // - Volunteers can register and update their own presence/coordinates.
    // - Authorized clients/command center can read helper records to fetch proximity listings.
    match /helpers/{helperId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(helperId);
      allow delete: if isOwner(helperId) || request.auth.token.role == 'ADMIN';
    }

    // Active Mission Tracking
    // - Authenticated users can read mission states.
    // - Only the assigned volunteer helper or admin can update the active mission status.
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.helperId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.helperId == request.auth.uid ||
        request.auth.token.role == 'ADMIN'
      );
      allow delete: if request.auth.token.role == 'ADMIN';
    }
  }
}
