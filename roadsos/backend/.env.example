# -------------------------------------------------------------
# RoadSOS Backend Command Center — Environment Configuration
# -------------------------------------------------------------

# Flask application configurations
# (backend/.env is read automatically by `python app.py`; variables already
#  present in the shell/CI environment always win.)
FLASK_APP=app.py
FLASK_ENV=development

# 0 = safe default. Only set 1 on trusted networks: the Werkzeug debugger can
# execute code and is reachable on the listening port while enabled.
FLASK_DEBUG=0

# Bind address / port for `python app.py`.
# 0.0.0.0 = reachable from the LAN (needed so a physical phone can connect);
# use 127.0.0.1 when a reverse proxy on the same host forwards the traffic.
RUN_HOST=0.0.0.0
RUN_PORT=5000
PORT=5000

# Path to the Firebase Service Account Key JSON
# Default is 'serviceAccountKey.json' in the backend root directory
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json

# -------------------------------------------------------------
# Advisory ML severity prediction (optional — see docs/ml-model.md)
# The emergency workflows run normally with these unset.
# -------------------------------------------------------------

# Comma-separated list of browser origins allowed by CORS.
# Leave empty for local development (any origin is allowed, with a startup
# warning that says to restrict it).
# In production set this explicitly, e.g. ALLOWED_ORIGINS=https://dashboard.example.com
ALLOWED_ORIGINS=

# Optional shared secret for the /api/v1/predictions/* endpoints.
# When set, clients must send `X-API-Key: <value>` or `Authorization: Bearer <value>`.
# Leave empty to disable (local development only).
ROADSOS_API_KEY=

# Load the ~1.97 GB model at startup so the first request is fast.
# Set to 0 to skip eager loading (endpoints then report 503 until used).
MODEL_HEALTHCHECK=1

# Predictions per minute, per client IP (default 60).
PREDICTION_RATE_LIMIT_PER_MIN=60

# Request body cap in bytes for the Flask app (default 1 MB).
MAX_CONTENT_LENGTH=1048576

# Model artifact location (highest priority). If unset, the backend looks in
# MODEL_CACHE_DIR, then <repo>/models/. See backend/scripts/download_model.py.
MODEL_PATH=
MODEL_CACHE_DIR=
MODEL_HF_REPO=hayamwahdan/road-accident-severity-prediction
MODEL_HF_REVISION=c4a7daf40b05e506c3c00aca7c8ab00bc00db53c

# SHA-256 of the artifact, verified before the model is loaded. Keep this set
# in production: a tampered or truncated download is refused, never executed
# (loading a pickle is arbitrary code execution, so this check matters).
# Empty value disables the check.
MODEL_SHA256=B9E5BE7E6A24CEE9746C743F630E41FADE629E5A38A3DC9FE1017508FE7E98B2
